# ==============================================================================
# DEVSPACE FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit real credentials.
# On Vercel: Configure these variables in Project Settings > Environment Variables.
# NOTE: All Vite client-side environment variables must start with the VITE_ prefix.
# ==============================================================================

# --- 1. BACKEND REST API BASE URL ---
# Local development: http://localhost:3000/api
# Production (Render): https://your-backend-service.onrender.com/api
# (Ensure '/api' is appended to the backend domain name)
VITE_API_BASE_URL=http://localhost:3000/api
