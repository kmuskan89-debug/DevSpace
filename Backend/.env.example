# ==============================================================================
# DEVSPACE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in local development. Never commit real credentials.
# On Render: Configure these variables in Service Dashboard > Environment.
# ==============================================================================

# --- 1. CORE SERVER CONFIGURATION ---
# Port number for Express server. Render automatically sets this to 10000.
PORT=3000

# Runtime environment: 'development', 'production', or 'test'.
# In production, CORS strictly enforces the allowed origins whitelist.
NODE_ENV=development

# --- 2. DATABASE CONFIGURATION (MongoDB Atlas) ---
# Local development: mongodb://127.0.0.1:27017/DevSpace
# Production (Atlas): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/DevSpace?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/DevSpace

# --- 3. SECURITY & AUTHENTICATION ---
# Cryptographically strong random secret used to sign and verify JWT session tokens.
# Generate a secure string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production

# --- 4. CORS & CLIENT ACCESS (Production Frontend Whitelist) ---
# Primary URL of your deployed frontend (e.g., Vercel deployment)
CLIENT_URL=http://localhost:5173

# Comma-separated list of all allowed origins (include preview URLs or custom domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 5. OPTIONAL: CLOUDINARY FILE STORAGE ---
# Required only if implementing direct image/asset uploads to Cloudinary.
# The application currently supports avatars via direct URL strings.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- 6. OPTIONAL: TRANSACTIONAL EMAIL / SMTP ---
# Required only if configuring external transactional emails for password recovery.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=DevSpace <noreply@your-domain.com>
